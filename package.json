{
  "name": "ben-10-sl",
  "version": "1.0.0",
  "private": true,
  "description": "Ben 10 SL — Sinhala dubbed Ben 10 episode archive with an admin dashboard (Next.js + Neon Postgres).",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "tsc --noEmit",
    "db:reset": "node -e \"require('fs').rmSync('data/pglite',{recursive:true,force:true});console.log('local database removed — it will be re-created & seeded on next start')\"",
    "db:check": "node scripts/db-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/orbitron": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "lenis": "1.3.26",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.14.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
