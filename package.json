{
  "name": "ben-10-sl",
  "version": "1.0.0",
  "private": true,
  "description": "Ben 10 SL — Sinhala dubbed Ben 10 episode archive with an admin dashboard.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "tsc --noEmit",
    "db:reset": "node -e \"require('fs').rmSync('data/ben10sl.db',{force:true});console.log('database removed — it will be re-created & seeded on next start')\""
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "lenis": "1.3.26",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "@fontsource/noto-sans-sinhala": "5.3.0",
    "@fontsource-variable/orbitron": "5.3.0",
    "@fontsource/rajdhani": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.14.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
