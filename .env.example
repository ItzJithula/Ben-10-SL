# Ben 10 SL — environment configuration
# Copy this file to `.env.local` and adjust the values.

# Admin credentials (CHANGE THESE BEFORE GOING ONLINE)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ben10admin
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# Public site URL — used for sitemap.xml / robots.txt
SITE_URL=http://localhost:3000

# Optional: store the SQLite database somewhere else (defaults to ./data)
# DATA_DIR=/var/lib/ben10sl
