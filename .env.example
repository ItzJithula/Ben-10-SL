# Ben 10 SL — environment configuration
# Copy this file to `.env.local` and fill in your own values.

# Admin panel credentials
# ADMIN_PASSWORD is REQUIRED in production (NODE_ENV=production): without it the
# admin panel stays locked. For local development it may be omitted — the panel
# then accepts the documented starter credentials (see README).
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Signing key for the admin session cookie. Leave empty and a random key is
# generated per process (sessions then end whenever the server restarts).
ADMIN_SESSION_SECRET=

# Public site URL — used for sitemap.xml / robots.txt / OpenGraph
SITE_URL=http://localhost:3000

# Optional: store the SQLite database somewhere else (defaults to ./data)
# DATA_DIR=/var/lib/ben10sl
